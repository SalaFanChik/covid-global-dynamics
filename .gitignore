# виртуальное окружение
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# сырые данные скачиваются скриптом scripts/download_data.py (файл ~185 МБ)
data/raw/*.csv
!data/raw/owid-covid-codebook.csv

# большие производные файлы пересоздаются командой python main.py;
# снимок очищенных данных (≈21 МБ) оставляем — с ним проект запускается без интернета
data/processed/*.parquet
!data/processed/covid_clean.parquet
data/*.db
